SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SIGNUP_REDIRECT_URL=heapy://auth/callback
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=jdbc:postgresql://your-host:5432/postgres
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=your-database-password

# 작성자: 김진우 — 서버 외부의 서비스 계정 파일을 읽기 전용으로 제공한다.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
